# IVA Mensual — variables de entorno
# Copia este archivo a .env y completa los valores. NUNCA subas el .env real a git.

# --- Servidor ---
PORT=3500
NODE_ENV=production
# Días de vida de la sesión de login (cookie httpOnly). 7 recomendado si la
# app queda expuesta a Internet (Cloudflare/nginx); 30 por defecto.
SESSION_DIAS=7

# --- Base de datos (SQLite, se crea sola) ---
DB_PATH=./data/iva_mensual.db

# --- Fuente de datos RCV del SII ---
# sii        → login directo con clave tributaria (provider original)
# simpleapi  → API de terceros (requiere SIMPLEAPI_KEY)
RCV_PROVIDER=sii
SIMPLEAPI_KEY=xxxx-xxxx-xxxx-xxxx

# --- Usuario admin inicial (solo se usa la primera vez para sembrar la BD;
# después se administra desde Configuración → Usuarios) ---
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=cambia-esto

# --- Bóveda de secretos (FASE 1, software contable) ---
# Cifra las claves SII de las empresas en reposo (AES-256-GCM).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si cambia, los secretos ya cifrados dejan de ser legibles. OBLIGATORIA en producción.
SECRETOS_MASTER_KEY=

# --- Cosmético (aparece en reportes) ---
NOMBRE_CONTADOR=Johan Morales

# --- SAAS-3: pagos de la suscripción (MercadoPago) ---
# Token de la app (sandbox o producción) — sin esto el checkout queda deshabilitado en la UI.
MP_ACCESS_TOKEN=
# Secreto del webhook para validar x-signature (opcional: el estado del pago
# se re-confirma siempre contra la API de MP). Configurarlo en producción.
MP_WEBHOOK_SECRET=
# Base de la API (por defecto producción; sandbox con credenciales de prueba no necesita override).
# MP_BASE_URL=https://api.mercadopago.com
# URL pública del webhook y de retorno al navegador tras pagar.
PAGOS_NOTIFICATION_URL=https://app.jmvconsultores.cl/api/pagos/webhook/mercadopago
PAGOS_URL_RETORNO=https://app.jmvconsultores.cl/sistema/#suscripcion

# --- SAAS-3: factura electrónica de la suscripción (DTE 33 vía @devlas/dte-sii) ---
# La emisión exige firma electrónica, CAF de folios tipo 33 y resolución del SII.
# El sistema funciona sin esto; solo la EMISIÓN de facturas queda deshabilitada.
# DTE_CERT_PFX=/ruta/certificado.pfx     (o el .pfx en base64)
# DTE_CERT_PASS=
# DTE_CAF_XML=/ruta/caf_33.xml           (o el XML del CAF en base64)
# DTE_RUT_EMISOR=76123456-7
# DTE_RAZON_SOCIAL=JMV Consultores SpA
# DTE_GIRO=Servicios de contabilidad
# DTE_DIRECCION=Calle 123
# DTE_COMUNA=Santiago
# DTE_ACTECO=692000
# DTE_FCH_RESOL=2024-01-15
# DTE_NRO_RESOL=0
# DTE_AMBIENTE=certificacion             (certificacion | produccion)
